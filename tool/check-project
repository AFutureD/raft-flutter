#!/usr/bin/env python3
"""Run the workspace checks against an identified, unchanged source snapshot."""
import json
import os
import pathlib
import subprocess
import sys
if sys.version_info < (3, 11):
    raise SystemExit('Engineering checks require Python 3.11 or newer.')
root = pathlib.Path(__file__).resolve().parent.parent
check_env = dict(os.environ, PYTHONUTF8='1')
tool_command = lambda name: ([sys.executable] if os.name == 'nt' else []) + [str(root / 'tool' / name)]
stamp = lambda: subprocess.check_output(tool_command('source-hash'), text=True, env=check_env).strip()
source_hash = stamp()
results = {}
(root / '.local').mkdir(exist_ok=True)
with (root / '.local/host-collector-tests.txt').open('w') as log:
    results['host-collector-tests.txt'] = subprocess.run(
        [sys.executable, '-m', 'unittest', 'discover', '-s', str(root / 'tool/tests'), '-p', 'test_*.py', '-v'],
        cwd=root, env=check_env, stdout=log, stderr=subprocess.STDOUT).returncode == 0
checks = [('bindings-generator-pub-get.txt', ['pub', 'get', '--enforce-lockfile'], root / 'apps/raft_flutter/tool/bindings_generator'),
          ('all-project-tests.txt', ['test', 'test', '../../packages/raft_client/test', '../../packages/raft_sync/test', '../../packages/raft_ui/test', '../../packages/flutter_dynamic_icon_plus/test', '--no-pub', '--reporter', 'expanded'], root / 'apps/raft_flutter'),
          ('analyze-all.txt', ['analyze', '--no-pub'], root)]
for filename, args, cwd in checks:
    with (root / '.local' / filename).open('w') as log:
        results[filename] = subprocess.run([*tool_command('flutter'), *args], cwd=cwd, env=check_env, stdout=log, stderr=subprocess.STDOUT).returncode == 0
changed = stamp() != source_hash
(root / '.local/engineering-run.json').write_text(json.dumps({'sourceHash': source_hash, 'completed': all(results.values()) and not changed, 'checks': results}, indent=2))
print(json.dumps({'passed': all(results.values()) and not changed, 'sourceChanged': changed, 'checks': results}))
sys.exit(0 if all(results.values()) and not changed else 1)
