#!/usr/bin/env python3
"""Build an iOS simulator bundle with its App Group entitlements; never launch it.

Flutter's simulator build signs with empty entitlements. Re-signing the locally
built Runner and its extension lets simulator admission register the shared
container. A physical-device build must use real provisioning, not this helper.
"""
import argparse
import json
from pathlib import Path
import plistlib
import subprocess
import sys
import tempfile

from android_app import local_dev_version

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--build-number', type=int, default=1)
args = parser.parse_args()
if sys.platform != 'darwin' or args.build_number < 1:
    sys.exit('This build helper requires macOS and a positive build number.')
version = local_dev_version(ROOT)
subprocess.run([sys.executable, str(ROOT / 'tool/flutter'), 'build', 'ios',
                '--simulator', '--debug', f'--build-number={args.build_number}',
                f'--dart-define=RAFT_APP_VERSION={version}'],
               cwd=ROOT / 'apps/raft_flutter', check=True)
bundle = ROOT / 'apps/raft_flutter/build/ios/iphonesimulator/Runner.app'
extension = bundle / 'PlugIns/ShareExtension.appex'
with (bundle / 'Info.plist').open('rb') as stream:
    app_info = plistlib.load(stream)
with (extension / 'Info.plist').open('rb') as stream:
    ext_info = plistlib.load(stream)
group = 'group.app.raft.raftFlutter'
if (app_info['CFBundleIdentifier'] != 'app.raft.raftFlutter'
        or ext_info['CFBundleIdentifier'] != 'app.raft.raftFlutter.ShareExtension'
        or app_info.get('RaftAppGroup') != group or ext_info.get('RaftAppGroup') != group
        or app_info['CFBundleVersion'] != ext_info['CFBundleVersion']):
    sys.exit('Unexpected Runner/extension identity or App Group. Signing stopped.')
with tempfile.TemporaryDirectory(prefix='raft-ios-simulator-sign-') as temporary:
    entitlements = Path(temporary) / 'entitlements.plist'
    entitlements.write_bytes(plistlib.dumps({'com.apple.security.application-groups': [group],
                                           'get-task-allow': True}))
    for target in (extension, bundle):
        subprocess.run(['codesign', '--force', '--sign', '-', '--timestamp=none',
                        '--entitlements', str(entitlements), str(target)], check=True)
        subprocess.run(['codesign', '--verify', '--strict', str(target)], check=True)
        result = subprocess.check_output(['codesign', '--display', '--xml', '--entitlements', '-',
                                          str(target)], stderr=subprocess.PIPE)
        if plistlib.loads(result).get('com.apple.security.application-groups') != [group]:
            sys.exit('Signed App Group mismatch. Build stopped.')
print(json.dumps({'bundle': str(bundle), 'extension': str(extension),
                  'aboutVersion': version, 'nativeVersion': app_info['CFBundleShortVersionString'],
                  'buildNumber': app_info['CFBundleVersion'], 'appGroup': group,
                  'simulatorOnly': True, 'launched': False}))
