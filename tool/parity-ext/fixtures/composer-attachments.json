  "default": 10485760,
  "small": 4096
 },
 "routes": {
  "GET /attachments/upload-capabilities": {
   "maxBytes": 10485760,
   "directUploadEnabled": false,
   "directUploadThresholdBytes": null
  },
  "POST /attachments/upload": {
   "attachments": [
    {
     "id": "fixture-upload"
    }
   ]
  }
 },
 "routeSets": {
  "composer-checking": {
   "GET /attachments/upload-capabilities": {
    "$pending": true
   }
  },
  "composer-uploading": {
   "POST /attachments/upload": {
    "$pending": true
   }
  },
  "composer-failed": {
   "POST /attachments/upload": {
    "$status": 500,
    "$body": {
     "error": "Attachment storage timed out"
    }
   }
  },
  "composer-quota": {
   "POST /attachments/upload": {
    "$status": 402,
    "$body": {
     "error": "Monthly file upload quota exceeded"
    }
   }
  },
  "composer-small-limit": {
   "GET /attachments/upload-capabilities": {
    "maxBytes": 4096,
    "directUploadEnabled": false,
    "directUploadThresholdBytes": null
   }
  }
 },
