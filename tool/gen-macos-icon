#!/usr/bin/env python3
"""Render macOS AppIcon assets from the shared Android Raft brand paths."""
from pathlib import Path
import shutil
import subprocess
import xml.etree.ElementTree as ET

root = Path(__file__).resolve().parent.parent
renderer = shutil.which('rsvg-convert')
if renderer is None:
    raise SystemExit('rsvg-convert is required to regenerate icon assets.')
source = root / 'apps/raft_flutter/android/app/src/main/res/drawable/ic_launcher_foreground.xml'
paths = ET.parse(source).getroot().find('group').findall('path')
android = '{http://schemas.android.com/apk/res/android}'
mark = ''.join(
    f'<path fill="#{p.attrib[android + "fillColor"][-6:]}" '
    f'd="{p.attrib[android + "pathData"]}"/>'
    for p in paths
)
scale = 640 / 274
y = (1024 - 253 * scale) / 2
svg = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024">'
    '<rect x="100" y="100" width="824" height="824" rx="184" fill="#FFD440"/>'
    f'<g transform="translate(192 {y}) scale({scale})">{mark}</g></svg>'
)
output = root / 'apps/raft_flutter/macos/Runner/Assets.xcassets/AppIcon.appiconset'
for size in [16, 32, 64, 128, 256, 512, 1024]:
    subprocess.run(
        [renderer, '-w', str(size), '-h', str(size), '-o', str(output / f'app_icon_{size}.png')],
        input=svg.encode(), check=True,
    )
print('Generated macOS Raft AppIcon: 16–1024 px')
