<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand launch window, independent of system light/dark mode. Flutter
         switches to NormalTheme before its first frame, so both need the
         same background while local startup data is being restored. -->
    <style name="RaftLaunchWindow" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="LaunchTheme" parent="RaftLaunchWindow" />
    <!-- Flutter owns the final page and system-bar colors after first paint. -->
    <style name="NormalTheme" parent="RaftLaunchWindow" />
</resources>
